POLARIS_CRAWL_WORKER_IMAGE=polaris/crawl-worker:<APPROVED_40_HEX_RELEASE_SHA>
# Production configuration contract for Polaris Commerce Studio.
# Copy to a secret-managed environment, replace every CHANGE_ME value, and do
# not commit the populated file. The Compose defaults are development-only.
POLARIS_ENVIRONMENT=production
POLARIS_AUTH_MODE=external
POLARIS_SUPERTOKENS_CONNECTION_URI=https://supertokens.example.internal
POLARIS_SUPERTOKENS_API_KEY=CHANGE_ME_LONG_CORE_API_KEY
POLARIS_SUPERTOKENS_API_DOMAIN=https://api.example.com
POLARIS_SUPERTOKENS_WEBSITE_DOMAIN=https://app.example.com
POLARIS_SUPERTOKENS_API_BASE_PATH=/api/auth
POLARIS_SUPERTOKENS_WEBSITE_BASE_PATH=/auth
POLARIS_SUPERTOKENS_COOKIE_SECURE=true
POLARIS_SUPERTOKENS_COOKIE_SAME_SITE=lax
POLARIS_AUTH_SMTP_HOST=smtp.example.com
POLARIS_AUTH_SMTP_PORT=587
POLARIS_AUTH_SMTP_USERNAME=CHANGE_ME
POLARIS_AUTH_SMTP_PASSWORD=CHANGE_ME
POLARIS_AUTH_SMTP_SECURE=true
POLARIS_AUTH_EMAIL_FROM_NAME=Polaris Commerce Studio
POLARIS_AUTH_EMAIL_FROM_ADDRESS=no-reply@example.com
POLARIS_ANNOUNCEMENT_ADMIN_EMAILS=["ops@example.com"]
POLARIS_DATABASE_URL=postgresql+psycopg://polaris:CHANGE_ME@postgres:5432/polaris
POLARIS_AUTO_CREATE_SCHEMA=false
POLARIS_STORAGE_BACKEND=s3
POLARIS_S3_ENDPOINT_URL=https://s3.example.internal
POLARIS_S3_REGION=us-east-1
POLARIS_S3_ACCESS_KEY=CHANGE_ME
POLARIS_S3_SECRET_KEY=CHANGE_ME
POLARIS_S3_BUCKET=polaris-assets
POLARIS_S3_AUTO_CREATE_BUCKET=false
POLARIS_ASSET_ACCESS_URL_MODE=auto
POLARIS_TASK_DISPATCHER=celery
POLARIS_CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/0
POLARIS_CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/1
POLARIS_ACCESS_URL_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
POLARIS_ECOMMERCE_PROXY_ENABLED=false
# Controlled human-assisted login is disabled by default. To enable the
# production QR workflow, change only the first value through secret-managed
# server configuration after operational approval.
POLARIS_ECOMMERCE_LOGIN_ENABLED=false
POLARIS_ECOMMERCE_LOGIN_TRANSPORT=headless_qr
POLARIS_ECOMMERCE_LOGIN_SESSION_TIMEOUT_SECONDS=600
POLARIS_AUTO_PROCESS_JOBS=true
POLARIS_TASK_RUNNER=mock
POLARIS_PROVIDER_QUOTA_ENABLED=true
POLARIS_WORKSPACE_CREDIT_ENFORCEMENT_ENABLED=true
POLARIS_RETENTION_ENABLED=true
POLARIS_RETENTION_DAYS=30
POLARIS_RETENTION_INTERVAL_SECONDS=3600
POLARIS_RETENTION_BATCH_SIZE=100
POLARIS_CORS_ORIGINS=["https://app.example.com"]
# These paths must be mounted on a durable, access-controlled volume shared by
# API and crawl-worker. Never point them at a developer's browser profile.
POLARIS_ECOMMERCE_SESSION_DIR=/app/.data/ecommerce-session/domestic-taobao-tmall
POLARIS_ECOMMERCE_1688_SESSION_DIR=/app/.data/ecommerce-session/domestic-1688
POLARIS_ECOMMERCE_JD_SESSION_DIR=/app/.data/ecommerce-session/domestic-jd
POLARIS_ECOMMERCE_PINDUODUO_SESSION_DIR=/app/.data/ecommerce-session/domestic-pinduoduo
# Clear inherited proxy variables for all domestic-platform containers.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
http_proxy=
https_proxy=
all_proxy=
NO_PROXY=*
no_proxy=*
