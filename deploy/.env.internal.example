# Template only. Copy it to /etc/polaris/polaris.env on the server, replace every
# marker there, then set owner root:root and mode 0600. Never put the real file
# in Git, a build context, command output, shell history, or a support bundle.

# Immutable release images. Both tags must exactly equal POLARIS_RELEASE_SHA.
POLARIS_RELEASE_SHA=<APPROVED_40_HEX_RELEASE_SHA>
POLARIS_BACKEND_IMAGE=polaris/backend:<APPROVED_40_HEX_RELEASE_SHA>
POLARIS_FRONTEND_IMAGE=polaris/frontend:<APPROVED_40_HEX_RELEASE_SHA>

# Approved linux/amd64 third-party images. Placeholder digests are rejected.
POLARIS_PYTHON_BASE_IMAGE=python:3.13.14-slim@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_NODE_BASE_IMAGE=node:22.22.0-bookworm-slim@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_POSTGRES_IMAGE=postgres:18.4-alpine@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_REDIS_IMAGE=redis:8.6.4-alpine@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_CADDY_IMAGE=caddy:2.10.2-alpine@sha256:<APPROVED_64_HEX_DIGEST>

# Server-local secrets. Markers are intentionally unusable.
POLARIS_POSTGRES_PASSWORD=<SET_ON_SERVER_RANDOM_POSTGRES_PASSWORD>
POLARIS_REDIS_PASSWORD=<SET_ON_SERVER_RANDOM_REDIS_PASSWORD>
POLARIS_MINIO_ROOT_USER=<SET_ON_SERVER_RANDOM_MINIO_USER>
POLARIS_MINIO_ROOT_PASSWORD=<SET_ON_SERVER_RANDOM_MINIO_PASSWORD>
POLARIS_ACCESS_URL_SECRET=<SET_ON_SERVER_LONG_RANDOM_SIGNING_SECRET>


# Keep mock until a real-provider path is approved. This internal development
# profile may set POLARIS_PROVIDER_QUOTA_ENABLED=false for an unrestricted test
# account; production startup remains fail-closed when quota tracking is disabled.
# All Provider feature switches remain false until explicitly approved.
# The API key must be created only in the server-local file.
POLARIS_AURORA_EXECUTION_MODE=sequential_v20
POLARIS_TASK_RUNNER=mock
POLARIS_PROVIDER_QUOTA_ENABLED=false
# Internal beta: track credit usage without enforcing a membership balance.
POLARIS_WORKSPACE_CREDIT_ENFORCEMENT_ENABLED=false
POLARIS_PRODUCT_IMAGE_PROVIDER_ENABLED=false
POLARIS_REFERENCE_REMIX_PROVIDER_ENABLED=false
POLARIS_MODEL_POSE_TRANSFER_PROVIDER_ENABLED=false
POLARIS_CREATIVE_IMAGE_PROVIDER_ENABLED=false
POLARIS_AMAZON_VISUAL_SUITE_PROVIDER_ENABLED=false
POLARIS_DOMESTIC_MAIN_IMAGE_PROVIDER_ENABLED=false
POLARIS_CROSSBORDER_DETAIL_PROVIDER_ENABLED=false
POLARIS_TENGLI_API_KEY=<SET_ON_SERVER_PROVIDER_API_KEY>
POLARIS_TENGLI_BASE_URL=https://api.tengliapi.xyz:8443
POLARIS_TENGLI_IMAGE_MODEL=gpt-image-2
POLARIS_TENGLI_VISION_MODEL=gpt-5.6-terra
POLARIS_ANALYSIS_API_KEY=<SET_ON_SERVER_ANALYSIS_API_KEY>
POLARIS_ANALYSIS_BASE_URL=https://api.ooapi.cc
POLARIS_ANALYSIS_MODEL=gpt-5.6-sol
POLARIS_IMAGE_API_KEY=<SET_ON_SERVER_IMAGE_API_KEY>
POLARIS_IMAGE_BASE_URL=https://api.artflow.vip
POLARIS_IMAGE_MODEL=gpt-image-2.5-flare
# Technical per-job runaway guard, not a membership quota.
POLARIS_TENGLI_SMOKE_BUDGET_USD=200
# When quota tracking is enabled, 0 means unlimited for recurring limits.
POLARIS_TENGLI_DAILY_BUDGET_USD=0
POLARIS_TENGLI_MONTHLY_BUDGET_USD=0
POLARIS_TENGLI_DAILY_REQUEST_LIMIT=0
POLARIS_TENGLI_PLANNER_RESERVE_MICROS=250000
POLARIS_XINGHE_CONCURRENCY=3000
POLARIS_XINGHE_SKILL_ROOT=/app/skill_sources/xinghe-ecommerce-detail
# Synthetic internal identity and private object bucket for the mock environment.
POLARIS_S3_BUCKET=polaris-internal-mock
POLARIS_DEVELOPMENT_USER_ID=usr_internal_mock
POLARIS_DEVELOPMENT_WORKSPACE_ID=ws_internal_mock
POLARIS_DEVELOPMENT_WORKSPACE_NAME=Internal Mock Workspace
