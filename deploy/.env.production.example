# Production template only. The real file must live outside Git, normally at
# /etc/polaris/polaris.production.env with root:root ownership and mode 0600.

POLARIS_RELEASE_SHA=<APPROVED_40_HEX_RELEASE_SHA>
POLARIS_BACKEND_IMAGE=polaris/backend:<APPROVED_40_HEX_RELEASE_SHA>
POLARIS_CRAWL_WORKER_IMAGE=polaris/crawl-worker:<APPROVED_40_HEX_RELEASE_SHA>
POLARIS_FRONTEND_IMAGE=polaris/frontend:<APPROVED_40_HEX_RELEASE_SHA>

POLARIS_PYTHON_BASE_IMAGE=python:3.13.14-slim@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_NODE_BASE_IMAGE=node:22.22.0-bookworm-slim@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_POSTGRES_IMAGE=postgres:18.4-alpine@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_REDIS_IMAGE=redis:8.6.4-alpine@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:<APPROVED_64_HEX_DIGEST>
POLARIS_CADDY_IMAGE=caddy:2.10.2-alpine@sha256:<APPROVED_64_HEX_DIGEST>
# Verified linux/amd64 manifest for SuperTokens Core v12.0.10.
POLARIS_SUPERTOKENS_IMAGE=supertokens/supertokens-postgresql:12.0.10@sha256:4516ec7c00b8fb2a773012694d8ebf03b54799d59cfc974160590f16d235ce72

POLARIS_POSTGRES_PASSWORD=<PRESERVE_EXISTING_OR_GENERATE_ON_SERVER>
POLARIS_REDIS_PASSWORD=<PRESERVE_EXISTING_OR_GENERATE_ON_SERVER>
POLARIS_MINIO_ROOT_USER=<PRESERVE_EXISTING_OR_GENERATE_ON_SERVER>
POLARIS_MINIO_ROOT_PASSWORD=<PRESERVE_EXISTING_OR_GENERATE_ON_SERVER>
POLARIS_ACCESS_URL_SECRET=<PRESERVE_EXISTING_OR_GENERATE_ON_SERVER>
POLARIS_SUPERTOKENS_API_KEY=<GENERATE_ON_SERVER>

POLARIS_AUTH_SMTP_HOST=<SMTP_PROVIDER_HOST>
POLARIS_AUTH_SMTP_PORT=587
POLARIS_AUTH_SMTP_USERNAME=<SMTP_PROVIDER_USERNAME>
POLARIS_AUTH_SMTP_PASSWORD=<ENTER_ON_SERVER_WITH_HIDDEN_PROMPT>
POLARIS_AUTH_SMTP_SECURE=false
POLARIS_AUTH_EMAIL_FROM_NAME=Polaris Commerce Studio
POLARIS_AUTH_EMAIL_FROM_ADDRESS=no-reply@mail.tengliapi.xyz
POLARIS_ACME_EMAIL=<OPERATIONS_EMAIL_ADDRESS>
POLARIS_ANNOUNCEMENT_ADMIN_EMAILS=<APPROVED_ADMIN_EMAILS_JSON_ARRAY>

# Preserve the currently approved Provider settings; this auth deployment must
# not silently enable, disable, or rotate Provider capabilities.
POLARIS_AURORA_EXECUTION_MODE=sequential_v20
POLARIS_TASK_RUNNER=mock
POLARIS_PROVIDER_QUOTA_ENABLED=true
POLARIS_WORKSPACE_CREDIT_ENFORCEMENT_ENABLED=false
POLARIS_PRODUCT_IMAGE_PROVIDER_ENABLED=false
POLARIS_REFERENCE_REMIX_PROVIDER_ENABLED=false
POLARIS_MODEL_POSE_TRANSFER_PROVIDER_ENABLED=false
POLARIS_CREATIVE_IMAGE_PROVIDER_ENABLED=false
POLARIS_AMAZON_VISUAL_SUITE_PROVIDER_ENABLED=false
POLARIS_DOMESTIC_MAIN_IMAGE_PROVIDER_ENABLED=false
POLARIS_CROSSBORDER_DETAIL_PROVIDER_ENABLED=false
POLARIS_TENGLI_API_KEY=<PRESERVE_EXISTING_SERVER_VALUE_IF_USED>
POLARIS_TENGLI_BASE_URL=https://api.tengliapi.xyz:8443
POLARIS_TENGLI_IMAGE_MODEL=gpt-image-2
POLARIS_TENGLI_VISION_MODEL=gpt-5.6-terra
POLARIS_ANALYSIS_MODEL=gpt-5.6-sol
POLARIS_TENGLI_SMOKE_BUDGET_USD=200
POLARIS_TENGLI_DAILY_BUDGET_USD=0
POLARIS_TENGLI_MONTHLY_BUDGET_USD=0
POLARIS_TENGLI_DAILY_REQUEST_LIMIT=0
POLARIS_TENGLI_PLANNER_RESERVE_MICROS=250000
POLARIS_XINGHE_CONCURRENCY=3000
POLARIS_IMAGE_GLOBAL_CONCURRENCY=3000
POLARIS_REPLICA_ANALYSIS_CONCURRENCY=0
POLARIS_WORKER_CONCURRENCY=3000
POLARIS_XINGHE_SKILL_ROOT=/app/skill_sources/xinghe-ecommerce-detail
POLARIS_S3_BUCKET=polaris-production
