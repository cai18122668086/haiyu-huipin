{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity.schema.json",
  "type": "object",
  "required": ["request_id", "product_form", "identity_summary", "evidence", "must_preserve", "must_not_change", "previous_generated_images_used"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "product_form": {"type": "string", "minLength": 1},
    "identity_summary": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["evidence_id", "path", "view_tags"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "view_tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "must_not_change": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "previous_generated_images_used": {"const": false}
  },
  "additionalProperties": false
}
