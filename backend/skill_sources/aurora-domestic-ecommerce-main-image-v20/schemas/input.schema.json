{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "type": "object",
  "required": ["request_id", "product"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "product": {
      "type": "object",
      "required": ["name", "category", "original_references"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "original_references": {"type": "array", "minItems": 1, "items": {"type": ["string", "object"]}},
        "verified_attributes": {"type": ["array", "object"]},
        "verified_selling_points": {"type": ["array", "object"]},
        "user_provided_display_facts": {"type": ["array", "object"]},
        "verified_scenes": {"type": ["array", "object"]},
        "verified_offers": {"type": ["array", "object"]},
        "verified_service_or_trust_facts": {"type": ["array", "object"]}
      },
      "additionalProperties": true
    },
    "campaign_preference": {"type": "object"},
    "durable_goods_prior_opt_in": {"type": "boolean"}
  },
  "additionalProperties": true
}
