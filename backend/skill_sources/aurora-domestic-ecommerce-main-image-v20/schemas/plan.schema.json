{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "type": "object",
  "required": ["schema_version", "strategy", "campaign_style", "pages"],
  "properties": {
    "schema_version": {"const": "aurora-six-image-plan-2.0.0"},
    "strategy": {
      "type": "object",
      "required": ["purchase_decision_type", "main_resistance", "campaign_thesis"],
      "properties": {
        "purchase_decision_type": {"type": "string", "minLength": 1},
        "main_resistance": {"type": "string", "minLength": 1},
        "campaign_thesis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "campaign_style": {
      "type": "object",
      "required": ["route_id", "photography_finish", "light_direction", "color_temperature", "palette_roles", "palette_usage_ratio", "typography", "graphic_language", "information_surfaces", "density_band", "prohibited_styles"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "photography_finish": {"type": "string", "minLength": 1},
        "light_direction": {"type": "string", "minLength": 1},
        "color_temperature": {"type": "string", "minLength": 1},
        "palette_roles": {"type": "object"},
        "palette_usage_ratio": {"type": "object"},
        "typography": {"type": "object"},
        "graphic_language": {"type": "string", "minLength": 1},
        "information_surfaces": {"type": "string", "minLength": 1},
        "density_band": {"type": "string", "minLength": 1},
        "prohibited_styles": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "pages": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["index", "page_role", "buyer_question", "primary_claim", "display_copy_contract", "supporting_claims", "claim_bundle", "visual_proof", "evidence_ids", "shot_key", "layout_contract", "reading_path", "type_hierarchy", "commercial_closure", "non_repetition_reason", "selling_point_visual_proof_contract", "visual_performance_contract", "approved_page_execution_contract", "generation_mode"],
        "properties": {
          "index": {"type": "integer", "minimum": 0, "maximum": 5},
          "page_role": {"type": "string", "minLength": 1},
          "buyer_question": {"type": "string", "minLength": 1},
          "primary_claim": {"type": "string", "minLength": 1},
          "display_copy_contract": {"type": "object"},
          "supporting_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "claim_bundle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "visual_proof": {"type": "string", "minLength": 1},
          "observability": {"enum": ["DIRECTLY_VISIBLE", "ACTION_DEMONSTRABLE", "TEXT_ONLY_VERIFIED", "NOT_RENDERABLE"]},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "shot_key": {"type": "object"},
          "layout_contract": {"type": "object"},
          "reading_path": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
          "type_hierarchy": {"type": "object"},
          "commercial_closure": {"type": "string", "minLength": 1},
          "non_repetition_reason": {"type": "string", "minLength": 1},
          "selling_point_visual_proof_contract": {"type": "object"},
          "visual_performance_contract": {"type": "object"},
          "approved_page_execution_contract": {"type": "object"},
          "search_cover_blueprint": {"type": "object"},
          "generation_mode": {"enum": ["PRODUCT_PRESERVING_EDIT", "REFERENCE_GUIDED_GENERATION"]},
          "edit_target_evidence_id": {"type": ["string", "null"]},
          "prompt": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
