{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aurora Detail Page Input v4.3",
  "type": "object",
  "required": ["product_name", "category", "target_buyer", "product_images", "verified_facts", "conflict_scan", "source_conflicts", "reference_materials", "platform_profile"],
  "properties": {
    "intake_route": {"enum": ["USER_SELLING_POINT_LED", "PHOTO_TO_PRODUCT_STRATEGY"]},
    "user_supplied_selling_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "source_ref", "fact_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "operating_analysis": {
      "type": "object",
      "required": ["route_reason", "confirmed_fact_ids", "buyer_hypotheses", "pain_hypotheses", "value_bridges", "positioning_candidates", "selected_positioning_id", "evidence_gaps", "assumption_disclosure"],
      "properties": {
        "route_reason": {"type": "string", "minLength": 10},
        "confirmed_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "buyer_hypotheses": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "buyer", "scenario", "reasoning", "confidence"], "properties": {
            "id": {"type": "string", "minLength": 1}, "buyer": {"type": "string", "minLength": 1}, "scenario": {"type": "string", "minLength": 1}, "reasoning": {"type": "string", "minLength": 1}, "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]}
          }}
        },
        "pain_hypotheses": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "pain", "kind", "reasoning", "claim_boundary"], "properties": {
            "id": {"type": "string", "minLength": 1}, "pain": {"type": "string", "minLength": 1}, "kind": {"enum": ["FUNCTIONAL", "EXPERIENCE", "SCENE", "DECISION", "TRANSACTION_RISK"]}, "reasoning": {"type": "string", "minLength": 1}, "claim_boundary": {"type": "string", "minLength": 1}
          }}
        },
        "value_bridges": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "fact_ids", "pain_id", "feature", "buyer_benefit", "purchase_reason", "visual_route", "claim_permission"], "properties": {
            "id": {"type": "string", "minLength": 1}, "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "pain_id": {"type": "string", "minLength": 1}, "feature": {"type": "string", "minLength": 1}, "buyer_benefit": {"type": "string", "minLength": 1}, "purchase_reason": {"type": "string", "minLength": 1}, "visual_route": {"type": "string", "minLength": 1}, "claim_permission": {"enum": ["VERIFIED_CLAIM", "SCENE_HYPOTHESIS_ONLY"]}
          }}
        },
        "positioning_candidates": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "thesis", "score_rationale", "decision"], "properties": {
            "id": {"type": "string", "minLength": 1}, "thesis": {"type": "string", "minLength": 1}, "score_rationale": {"type": "string", "minLength": 10}, "decision": {"enum": ["SELECTED", "REJECTED"]}
          }}
        },
        "selected_positioning_id": {"type": "string", "minLength": 1},
        "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumption_disclosure": {"type": "string", "minLength": 10}
      }
    },
    "product_name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "target_buyer": {"type": "string", "minLength": 1},
    "primary_scenario": {"type": "string"},
    "coverage_directive": {"const": "MAXIMIZE_USER_SUPPLIED_RELEVANT_FACTS", "default": "MAXIMIZE_USER_SUPPLIED_RELEVANT_FACTS"},
    "question_budget": {"const": 0, "default": 0},
    "conflict_policy": {"const": "BLOCK_PLAN_AND_BATCH_ASK", "default": "BLOCK_PLAN_AND_BATCH_ASK"},
    "conflict_scan": {
      "type": "object",
      "required": ["status", "scanned_topics", "conflict_ids"],
      "properties": {
        "status": {"enum": ["CLEAR", "CONFLICTS_FOUND"]},
        "scanned_topics": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "conflict_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "source_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "alternative_fact_ids", "why_material", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "topic": {"type": "string", "minLength": 1},
          "alternative_fact_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "why_material": {"type": "string", "minLength": 10},
          "status": {"enum": ["UNRESOLVED", "RESOLVED"]},
          "resolution": {"type": "object"}
        }
      }
    },
    "reference_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "category", "analysis_status", "observed_expression_methods", "analyzed_units"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "analysis_status": {"const": "ANALYZED"},
          "observed_expression_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "analyzed_units": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "source_region", "page_duty", "visual_carrier", "composition_logic", "typography_logic", "observed_expression_method"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "source_region": {"type": "string", "minLength": 1},
                "page_duty": {"type": "string", "minLength": 1},
                "visual_carrier": {"type": "string", "minLength": 1},
                "composition_logic": {"type": "string", "minLength": 1},
                "typography_logic": {"type": "string", "minLength": 1},
                "observed_expression_method": {"type": "string", "minLength": 10}
              }
            }
          }
        }
      }
    },
    "product_images": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "path", "role"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "role": {"type": "string"}}}
    },
    "verified_facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "source_class", "evidence_ref", "claim_kind", "display_intent", "user_prominence", "named_elements"],
        "properties": {
          "id": {"type": "string"},
          "atomic_key": {"type": "string", "minLength": 1},
          "atomicity": {"const": "ONE_INDEPENDENT_PROPOSITION"},
          "text": {"type": "string"},
          "source_class": {"enum": ["USER_FACT", "DOCUMENTED_EVIDENCE", "OBSERVED_PRODUCT_EVIDENCE"]},
          "evidence_ref": {"type": "string"},
          "claim_kind": {"enum": ["PRODUCT_IDENTITY", "PERFORMANCE", "INGREDIENT_FORMULA", "STRUCTURE_COMPONENT", "SENSORY", "USE", "SPECIFICATION", "TRUST", "AUDIENCE", "SAFETY", "OTHER"]},
          "user_prominence": {"enum": ["CORE_SELLING_POINT", "SUPPORTING_POINT", "INCIDENTAL_DISCLOSURE"]},
          "named_elements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "conditions": {"type": "string"},
          "risk_route": {"enum": ["USER_CONFIRMED_FACT", "DOCUMENTED_FACT", "EXPERIENCE_EXPRESSION", "HIGH_RISK_CLAIM", "CONFLICTING_FACT", "UNSUPPORTED_INVENTION"]},
          "display_intent": {"enum": ["MUST_SHOW", "SHOW_IF_RELEVANT", "CONTEXT_ONLY"]},
          "claim_risk_contract": {
            "type": "object",
            "required": ["evidence_level", "allowed_phrases", "forbidden_phrases", "evidence_sources", "effect_implication_allowed", "qualification"],
            "properties": {
              "evidence_level": {"enum": ["REGULATORY_RECORD", "DOCUMENTED_TEST", "PACKAGING_ONLY", "USER_ASSERTION"]},
              "allowed_phrases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "forbidden_phrases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "evidence_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["type", "ref"], "properties": {"type": {"enum": ["REGULATORY", "TEST_REPORT", "PACKAGE", "USER_MATERIAL"]}, "ref": {"type": "string", "minLength": 1}}}},
              "effect_implication_allowed": {"type": "boolean"},
              "qualification": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "platform_profile": {
      "type": "object",
      "required": ["target_platform", "profile_name", "selection_mode", "selection_rationale", "source", "aspect_ratio", "canvas_width_px", "module_height_px", "safe_margin_px", "slice_height_px", "format", "verification_status"],
      "properties": {
        "target_platform": {"type": "string", "minLength": 1},
        "profile_name": {"type": "string", "minLength": 1},
        "selection_mode": {"enum": ["ADAPTIVE_PLANNED", "USER_SPECIFIED", "PLATFORM_VERIFIED"]},
        "selection_rationale": {"type": "string", "minLength": 20},
        "source": {"type": "string", "minLength": 1},
        "aspect_ratio": {"type": "object", "required": ["width_units", "height_units", "label"], "properties": {"width_units": {"type": "integer", "minimum": 1}, "height_units": {"type": "integer", "minimum": 1}, "label": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}}},
        "canvas_width_px": {"type": "integer", "minimum": 500}, "module_height_px": {"type": "integer", "minimum": 500}, "safe_margin_px": {"type": "integer", "minimum": 0}, "slice_height_px": {"type": "integer", "minimum": 200}, "format": {"enum": ["PNG", "JPEG", "WEBP"]}, "max_file_bytes": {"type": ["integer", "null"]}, "verification_status": {"enum": ["BACKEND_CONFIRMATION_REQUIRED", "VERIFIED_CURRENT_BACKEND", "INTERNAL_ONLY"]}
      }
    }
  }
}


