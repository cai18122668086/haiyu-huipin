{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aurora Candidate Generation Import v4.3",
  "type": "object",
  "required": ["request", "request_fingerprint", "selected_candidate", "candidates"],
  "properties": {
    "request": {"type": "string", "minLength": 1},
    "request_fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "selected_candidate": {"type": "integer", "minimum": 0},
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["token", "pair_id", "module_ids", "image", "image_sha256"],
        "properties": {
          "token": {"type": "string", "minLength": 1},
          "pair_id": {"type": ["string", "null"]},
          "module_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "image": {"type": "string", "minLength": 1},
          "image_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  }
}
