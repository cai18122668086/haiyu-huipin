  "properties": {
    "information_contract_version": {"const": "4.1"},
    "expression_contract_version": {"const": "4.3"},
    "hero_screen_contract": {"type": "object"},
    "detail_information_contract": {"type": "object"},
    "detail_page_information_sufficiency": {"type": "object"},
    "campaign_thesis": {"type": "string", "minLength": 1},
    "operating_strategy": {
      "type": "object",
      "required": ["intake_route", "target_buyer", "primary_pain_id", "selected_positioning_id", "core_promise", "priority_claim_ids", "supporting_claim_ids", "assumption_boundary"],
      "properties": {
        "intake_route": {"enum": ["USER_SELLING_POINT_LED", "PHOTO_TO_PRODUCT_STRATEGY"]},
        "target_buyer": {"type": "string", "minLength": 1},
        "primary_pain_id": {"type": "string", "minLength": 1},
        "selected_positioning_id": {"type": "string", "minLength": 1},
        "core_promise": {"type": "string", "minLength": 1},
        "priority_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "supporting_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assumption_boundary": {"type": "string", "minLength": 10}
      }
    },
    "campaign_recall_contract": {
      "type": "object",
      "required": ["must_remember_claim_ids", "first_screen_value_claim_ids", "proof_module_ids_by_claim", "closure_reinforcement_claim_ids", "buyer_recall_test"],
      "properties": {
        "must_remember_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "first_screen_value_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "proof_module_ids_by_claim": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}}},
        "closure_reinforcement_claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "buyer_recall_test": {"type": "string", "minLength": 10}
      }
    },
    "dominant_decision_type": {"enum": ["sensory", "mechanism", "functional", "scene", "trust", "identity"]},
    "supporting_decision_types": {"type": "array", "items": {"type": "string"}},
    "buyer_doubts": {"type": "array", "items": {"type": "string"}},
    "output_strategy": {
      "type": "object",
      "required": ["target_platform", "profile_name", "selection_mode", "module_count", "module_count_rationale", "module_count_candidates", "selling_point_clusters", "merge_decisions", "claim_coverage", "aspect_ratio", "canvas_width_px", "module_height_px", "safe_margin_px", "slice_height_px", "dimension_rationale", "uniform_dimensions", "verification_status", "continuous_pair_rendering"],
      "properties": {
        "target_platform": {"type": "string", "minLength": 1},
        "profile_name": {"type": "string", "minLength": 1},
        "selection_mode": {"enum": ["ADAPTIVE_PLANNED", "USER_SPECIFIED", "PLATFORM_VERIFIED"]},
        "module_count": {"enum": [8, 10, 12]},
        "module_count_rationale": {"type": "string", "minLength": 20},
        "module_count_candidates": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"type": "object", "required": ["candidate_mode", "count", "coverage_tradeoff", "selling_point_fit", "story_obligation_fit", "primary_selling_point_depth_fit", "evidence_boundary_fit", "decision"], "properties": {"candidate_mode": {"enum": ["DIRECT_DERIVATION", "COMPACT_COVERAGE", "BALANCED_EXPRESSION", "FULL_SALES"]}, "count": {"enum": [8, 10, 12]}, "coverage_tradeoff": {"type": "string", "minLength": 10}, "selling_point_fit": {"type": "string", "minLength": 10}, "story_obligation_fit": {"type": "string", "minLength": 10}, "primary_selling_point_depth_fit": {"type": "string", "minLength": 10}, "evidence_boundary_fit": {"type": "string", "minLength": 10}, "decision": {"enum": ["SELECTED", "REJECTED"]}}}
        },
        "selling_point_clusters": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "buyer_question", "fact_ids", "purchase_role", "separation_policy", "assigned_module_ids"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "buyer_question": {"type": "string", "minLength": 1},
              "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "purchase_role": {"enum": ["ATTENTION", "PAIN", "MECHANISM", "BENEFIT", "SCENE", "TRUST", "SELECTION", "SPECIFICATION", "CLOSURE"]},
              "separation_policy": {"enum": ["MERGEABLE", "MUST_SEPARATE"]},
              "assigned_module_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}}
            }
          }
        },
        "merge_decisions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "claim_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim_id", "disposition", "module_ids", "rationale", "defer_reason_code"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "disposition": {"enum": ["LEAD", "SUPPORT", "CONTEXT_ONLY", "DEFERRED"]},
              "module_ids": {"type": "array", "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}},
              "rationale": {"type": "string", "minLength": 1},
              "defer_reason_code": {"enum": ["NOT_DEFERRED", "CONFLICTING_FACT", "HIGH_RISK_UNDOCUMENTED", "UNSUPPORTED_INVENTION", "IMMATERIAL_DUPLICATE"]}
            }
          }
        },
        "aspect_ratio": {
          "type": "object",
          "required": ["width_units", "height_units", "label"],
          "properties": {
            "width_units": {"type": "integer", "minimum": 1},
            "height_units": {"type": "integer", "minimum": 1},
            "label": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
          }
        },
        "canvas_width_px": {"type": "integer", "minimum": 1},
        "module_height_px": {"type": "integer", "minimum": 1},
        "safe_margin_px": {"type": "integer", "minimum": 0},
        "slice_height_px": {"type": "integer", "minimum": 1},
        "dimension_rationale": {"type": "string", "minLength": 20},
        "continuous_pair_rendering": {"$ref": "continuous-pair-render.schema.json"},
        "uniform_dimensions": {"const": true},
        "verification_status": {"enum": ["VERIFIED_CURRENT_BACKEND", "BACKEND_CONFIRMATION_REQUIRED", "INTERNAL_ONLY"]}
      }
    },
    "selling_point_depth_contract": {
      "type": "object",
      "required": ["selection_policy", "primary_claim_ids", "claim_depth", "compact_selection_exception"],
      "properties": {
        "selection_policy": {"const": "SMALLEST_CANDIDATE_THAT_SATISFIES_SALES_DEPTH_NOT_MINIMUM_FACT_LISTING"},
        "primary_claim_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "claim_depth": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim_id", "depth_tier", "evidence_ceiling", "required_decision_jobs", "scheduled_module_ids", "dedicated_module_ids", "non_duplicate_rationale", "forbidden_expansion"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "depth_tier": {"enum": ["DEEP", "STANDARD", "SUPPORT"]},
              "evidence_ceiling": {"enum": ["DIRECT_PROOF_AVAILABLE", "QUALIFIED_CLAIM_ONLY", "PACKAGING_CLAIM_ONLY", "CONTEXT_ONLY"]},
              "required_decision_jobs": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"enum": ["PROBLEM_CONTEXT", "VALUE_OVERVIEW", "DEDICATED_EXPRESSION", "MECHANISM_OR_REASON", "USE_SCOPE", "ACTION_OR_OPERATION", "RESULT_OR_EXPERIENCE", "RISK_QUALIFICATION", "SELECTION", "TRUST", "RECALL"]}
              },
              "scheduled_module_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}},
              "dedicated_module_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}},
              "non_duplicate_rationale": {"type": "string", "minLength": 10},
              "forbidden_expansion": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "compact_selection_exception": {"type": "string"}
      }
    },
    "campaign_pain_solution_contract": {
      "type": "object",
      "required": ["primary_pain_id", "coverage_mode", "pain_module_ids", "solution_module_ids", "value_bridge_ids", "visible_problem_boundary", "pain_to_solution_transition", "exemption_basis", "exemption_reason"],
      "properties": {
        "primary_pain_id": {"type": "string", "minLength": 1},
        "coverage_mode": {"enum": ["DEDICATED_PAIN_MODULE", "COMBINED_PAIN_SOLUTION_MODULE", "EXPLICITLY_NOT_APPLICABLE"]},
        "pain_module_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}},
        "solution_module_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}},
        "value_bridge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "visible_problem_boundary": {"type": "string", "minLength": 10},
        "pain_to_solution_transition": {"type": "string", "minLength": 10},
        "exemption_basis": {"enum": ["NOT_APPLICABLE", "USER_REQUESTED_NON_SALES_INFORMATION_PAGE"]},
        "exemption_reason": {"type": "string"}
      }
    },
    "formula_split_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "trigger_basis", "evaluated_claims", "entries"],
      "properties": {
        "enabled": {"type": "boolean"},
        "trigger_basis": {"type": "string", "minLength": 1},
        "evaluated_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "formula_or_element", "named_ingredient", "user_prominence", "display_intent", "supported_benefit", "buyer_question", "trigger_decision", "merge_target_claim_id", "reason"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "formula_or_element": {"type": "string", "minLength": 1},
              "named_ingredient": {"type": "boolean"},
              "user_prominence": {"enum": ["CORE_SELLING_POINT", "SUPPORTING_POINT", "INCIDENTAL_DISCLOSURE"]},
              "display_intent": {"enum": ["MUST_SHOW", "SHOW_IF_RELEVANT", "CONTEXT_ONLY"]},
              "supported_benefit": {"type": "string", "minLength": 1},
              "buyer_question": {"type": "string", "minLength": 1},
              "trigger_decision": {"enum": ["DEDICATED_EXPRESSION_REQUIRED", "MERGE_ALLOWED", "TEXT_ONLY", "BLOCKED"]},
              "merge_target_claim_id": {"type": ["string", "null"]},
              "reason": {"type": "string", "minLength": 10}
            }
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "formula_or_element", "independent_split_reason", "buyer_problem_or_question", "supported_benefit", "evidence_ceiling", "dedicated_module_id", "visual_expression_route"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "formula_or_element": {"type": "string", "minLength": 1},
              "independent_split_reason": {"type": "string", "minLength": 10},
              "buyer_problem_or_question": {"type": "string", "minLength": 1},
              "supported_benefit": {"type": "string", "minLength": 1},
              "evidence_ceiling": {"enum": ["DIRECT_PROOF_AVAILABLE", "QUALIFIED_CLAIM_ONLY", "PACKAGING_CLAIM_ONLY", "CONTEXT_ONLY"]},
              "dedicated_module_id": {"type": "string", "pattern": "^M[0-9]{2,}$"},
              "visual_expression_route": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "campaign_expression_diversity_contract": {
      "type": "object",
      "required": ["minimum_subject_classes", "minimum_presentation_forms", "maximum_complete_product_dominant_screens", "maximum_consecutive_same_signature", "required_when_evidence_available"],
      "properties": {
        "minimum_subject_classes": {"type": "integer", "minimum": 1},
        "minimum_presentation_forms": {"type": "integer", "minimum": 1},
        "maximum_complete_product_dominant_screens": {"type": "integer", "minimum": 1},
        "maximum_consecutive_same_signature": {"const": 1},
        "required_when_evidence_available": {"type": "array", "uniqueItems": true, "items": {"enum": ["HUMAN_USE_ACTION", "PRODUCT_DETAIL_OR_STRUCTURE", "MATERIAL_OR_INGREDIENT", "MECHANISM_OR_PROCESS", "DOCUMENT_OR_SPECIFICATION"]}}
      }
    },
    "campaign_visual_carrier_sequence": {
      "type": "object",
      "required": ["sequence", "max_consecutive_static_packshots", "minimum_carrier_classes", "campaign_rationale"],
      "properties": {
        "sequence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["module_id", "primary_visual_carrier", "static_packshot_primary", "expression_mode", "carrier_reason"], "properties": {"module_id": {"type": "string", "pattern": "^M[0-9]{2,}$"}, "primary_visual_carrier": {"enum": ["PRODUCT_HERO", "PAIN_SCENE", "ACTION_CONTACT", "STATE_CONTRAST", "PROCESS_PATH", "MATERIAL_MACRO", "RESULT_SCENE", "SCALE_RELATION", "DOCUMENT_EVIDENCE", "PRODUCT_DETAIL", "USE_SCENE", "SELECTION", "SPECIFICATION", "TRUST", "PURCHASE_CLOSURE"]}, "static_packshot_primary": {"type": "boolean"}, "expression_mode": {"enum": ["IMAGE_FIRST", "IMAGE_PLUS_COPY", "COPY_ONLY_JUSTIFIED"]}, "carrier_reason": {"type": "string", "minLength": 10}}}},
        "max_consecutive_static_packshots": {"type": "integer", "minimum": 0, "maximum": 2},
        "minimum_carrier_classes": {"type": "integer", "minimum": 1, "maximum": 15},
        "campaign_rationale": {"type": "string", "minLength": 20}
      }
    },
    "campaign_product_presence_rhythm": {
      "type": "object",
      "required": ["sequence", "full_product_return_module_ids", "absence_favored_module_ids", "campaign_rationale"],
      "properties": {
        "sequence": {"type": "array", "minItems": 1},
        "full_product_return_module_ids": {"type": "array", "items": {"type": "string"}},
        "absence_favored_module_ids": {"type": "array", "items": {"type": "string"}},
        "campaign_rationale": {"type": "string", "minLength": 20}
      }
    },
    "reference_expression_system": {
      "type": "object",
      "required": ["coverage", "adopted_patterns", "anti_copy_rule"],
      "properties": {
        "anti_copy_rule": {"const": "ADAPT_VISUAL_GRAMMAR_ONLY_NEVER_COPY_BRAND_COPY_OR_ASSET"},
        "coverage": {
          "type": "array",
          "items": {"type": "object", "required": ["reference_id", "disposition", "pattern_ids", "reason"], "properties": {"reference_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["ADOPTED_GRAMMAR", "REJECTED_IRRELEVANT"]}, "pattern_ids": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string", "minLength": 1}}}
        },
        "adopted_patterns": {
