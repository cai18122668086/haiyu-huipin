          "order": {"type": "integer", "minimum": 1},
          "duty": {"type": "string"},
          "buyer_question": {"type": "string"},
          "lead_conclusion": {"type": "string"},
          "lead_claim_id": {"type": "string"},
          "supporting_claim_ids": {"type": "array", "items": {"type": "string"}},
          "selling_point_cluster_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reference_pattern_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "story_function": {"enum": ["HOOK", "PAIN_ARTICULATION", "PAIN_SOLUTION_COMBINED", "SOLUTION_PROOF", "MECHANISM_PROOF", "MATERIAL_PROOF", "USE_OR_RESULT", "TRUST_OR_RISK_REMOVAL", "SELECTION_OR_SPECIFICATION", "PURCHASE_CLOSURE", "OTHER"]},
          "pain_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "value_bridge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "visual_proof_direction": {"type": "string"},
          "visual_evidence": {
            "type": "object",
            "required": ["evidence_class", "proof_device", "visible_content", "forbidden_inventions"],
            "properties": {
              "evidence_class": {"enum": ["DIRECT_VERIFIED", "CONDITIONALLY_VERIFIED", "SAFE_CONTEXT", "ILLUSTRATIVE_METAPHOR", "TEXT_VERIFIABLE_ONLY"]},
              "proof_device": {"type": "string"},
              "visible_content": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "forbidden_inventions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          },
          "visual_proof_contract": {
            "type": "object",
            "required": ["buyer_takeaway", "visual_verb", "primary_subject", "supporting_subjects", "required_relations", "minimum_visual_payload", "visual_specificity_anchor", "allowed_metaphor", "hidden_copy_test"],
            "properties": {
              "buyer_takeaway": {"type": "string", "minLength": 1},
              "visual_verb": {"type": "string", "minLength": 1},
              "primary_subject": {"type": "string", "minLength": 1},
              "supporting_subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "required_relations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "minimum_visual_payload": {"type": "integer", "minimum": 2, "maximum": 8},
              "visual_specificity_anchor": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "allowed_metaphor": {"type": ["string", "null"]},
              "hidden_copy_test": {"type": "string", "minLength": 1}
