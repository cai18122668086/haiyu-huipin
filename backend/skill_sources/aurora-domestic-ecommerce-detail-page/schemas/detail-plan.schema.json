          "items": {"type": "object", "required": ["id", "source_reference_ids", "source_unit_ids", "observed_method", "adaptation_for_product", "scheduled_module_ids", "do_not_copy", "fact_dependencies", "copy_or_claims_not_inherited"], "properties": {"id": {"type": "string", "minLength": 1}, "source_reference_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "source_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "observed_method": {"type": "string", "minLength": 10}, "adaptation_for_product": {"type": "string", "minLength": 10}, "scheduled_module_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^M[0-9]{2,}$"}}, "do_not_copy": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "fact_dependencies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "copy_or_claims_not_inherited": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
        }
      }
    },
    "style_constitution": {
      "type": "object",
      "required": ["visual_world", "color_and_light", "typography_and_graphics", "product_rendering", "rhythm"],
      "properties": {
