      "required": ["brand_anchor_system", "palette_tokens", "typography_tokens", "graphic_tokens", "photography_tokens", "product_tokens", "spatial_tokens", "invariants"],
      "properties": {
        "style_master_asset": {"type": ["string", "null"]},
        "brand_anchor_system": {"type": "string"},
        "palette_tokens": {"type": "string"},
        "typography_tokens": {"type": "string"},
        "graphic_tokens": {"type": "string"},
        "photography_tokens": {"type": "string"},
        "product_tokens": {"type": "string"},
        "spatial_tokens": {"type": "string"},
        "style_master_transfer_scope": {
          "type": "object",
          "required": ["allowed", "forbidden"],
          "properties": {
            "allowed": {
              "type": "array",
              "minItems": 4,
              "uniqueItems": true,
              "items": {"enum": ["PALETTE", "LIGHTING", "PHOTOGRAPHIC_FINISH", "TYPOGRAPHY_CHARACTER", "GRAPHIC_LANGUAGE", "PRODUCT_RENDERING", "RECURRING_MOTIF"]}
            },
            "forbidden": {
              "type": "array",
              "minItems": 6,
              "uniqueItems": true,
              "items": {"enum": ["LAYOUT_SKELETON", "SUBJECT_COORDINATES", "PRODUCT_OCCUPANCY", "TEXT_ZONE", "CAMERA_SCALE", "ZONE_GEOMETRY", "FULL_BLEED_TEMPLATE"]}
            }
          }
        },
        "invariants": {"type": "array", "minItems": 2, "items": {"type": "string"}}
      }
    },
    "typography_rhythm": {
      "type": "object",
      "required": ["campaign_rule", "primary_mode_sequence", "anchor_zone_sequence", "centered_hero_max", "consecutive_anchor_repeat_limit", "exceptions"],
      "properties": {
        "campaign_rule": {"type": "string", "minLength": 1},
        "primary_mode_sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "anchor_zone_sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "centered_hero_max": {"type": "integer", "minimum": 0},
        "consecutive_anchor_repeat_limit": {"type": "integer", "minimum": 1, "maximum": 2},
        "exceptions": {"type": "array", "items": {"type": "string"}}
      }
