  "patterns": [
    {
      "pattern_id": "V3-EXP-01-WARM-HOME-DETAIL",
      "name": "暖中性家居详情模块",
      "supported_by_case_count": 5,
      "controls": {
        "typography": {
          "headline": "深棕、深石墨或反白粗体，最多两行",
          "subtitle_ratio": [0.26, 0.32],
          "eyebrow_ratio": [0.18, 0.24],
          "emphasis_limit": 2,
          "semantic_line_break_required": true
        },
        "background": [
          "奶油白或浅米墙面",
          "浅木地板或桌面",
          "侧窗光影"
        ],
        "photography": {
          "full_product_occupancy": [45, 72],
          "significant_prop_limit": 5,
          "light_product_separation": "接触阴影与内容物色差",
          "dark_product_separation": "窗光轮廓与墙面明度"
        }
      }
    },
    {
      "pattern_id": "V3-EXP-02-MODULAR-COMBINATION",
      "name": "模块组合与配置节奏",
      "supported_by_case_count": 4,
      "controls": {
        "composition": "同一暖中性空间中轮换完整商品、组合场景和配置说明",
        "graphic_devices_max": 3,
        "allowed_devices": [
          "CONFIGURATION_PILL",
          "SIZE_LINE",
          "VARIANT_CARD"
        ],
        "fact_gate": "只有USER_FACT明确提供真实SKU组合、尺寸或层数时才可显示配置"
      }
    },
    {
      "pattern_id": "V3-EXP-03-STRUCTURE-PROOF",
      "name": "结构近景与证据卡",
      "supported_by_case_count": 4,
      "controls": {
        "composition": "两个不重复的同商品结构近景或证据区域",
        "detail_occupancy": [65, 90],
        "graphic_devices_max": 3,
        "allowed_devices": [
          "MAGNIFIER",
          "LEADER_LINE",
          "COMPARE_CARD",
          "PARAMETER_GRID"
        ],
        "evidence_gate": "必须绑定当前商品原始近景；指向不确定时删除引线"
      }
    }
  ],
