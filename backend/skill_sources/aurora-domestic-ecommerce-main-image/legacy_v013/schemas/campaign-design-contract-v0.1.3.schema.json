{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campaign-design-contract-v0.1.3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "source_precedence", "font_system", "color_system", "pages", "set_gates", "status", "profile01_semantics_read"],
  "properties": {
    "schema_version": {"const": "campaign-design-contract-0.1.3"},
    "request_id": {"type": "string"},
    "source_precedence": {"const": ["USER_FACT", "EVIDENCE_DERIVED", "ENGINEERED_DEFAULT", "MODEL_FREEDOM"]},
    "inputs": {"type": "object"},
    "font_system": {
      "type": "object",
      "required": ["font_personality", "headline_personality", "body_personality", "numeric_personality", "icon_personality", "source_type"]
    },
    "color_system": {
      "type": "object",
      "required": ["primary_text_color", "secondary_text_color", "accent_color", "secondary_accent_color", "information_surface_color", "offer_color", "inverse_text_color", "muted_text_color", "divider_color", "usage_ratio", "source_type"]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "page_role", "role_family", "treatment_id", "typography_levels", "copy_plan", "keyword_emphasis", "graphic_devices", "text_density", "design_fingerprint", "field_sources"]
      }
    },
    "set_gates": {"type": "object"},
    "status": {"enum": ["READY", "BLOCKED"]},
    "profile01_semantics_read": {"const": false}
  }
}
