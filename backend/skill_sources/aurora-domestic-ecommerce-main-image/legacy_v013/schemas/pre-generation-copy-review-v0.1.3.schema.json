{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pre-generation-copy-review-v0.1.3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "generation_allowed",
    "records",
    "blocked_records",
    "profile01_semantics_read"
  ],
  "properties": {
    "schema_version": {"const": "pre-generation-copy-review-0.1.3"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "generation_allowed": {"type": "boolean"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page_index",
          "text_role",
          "original_source_text",
          "compiled_visible_text",
          "source_type",
          "semantic_complete",
          "fact_traceable",
          "new_claim",
          "checks"
        ]
      }
    },
    "blocked_records": {"type": "array"},
    "profile01_semantics_read": {"const": false}
  }
}
