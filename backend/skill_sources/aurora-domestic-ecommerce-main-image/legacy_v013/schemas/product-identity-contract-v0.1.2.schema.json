{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-identity-contract-v0.1.2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "product",
    "reference_evidence",
    "identity",
    "must_preserve",
    "must_not_change",
    "view_specific_evidence",
    "evidence_conflicts",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "product-identity-contract-0.1.2"},
    "contract_id": {"type": "string", "minLength": 1},
    "product": {
      "type": "object",
      "required": ["name", "category", "quantity"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "quantity": {"type": "integer", "minimum": 1}
      }
    },
    "reference_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "path", "sha256", "view_tags"],
        "properties": {
          "evidence_id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "view_tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "category_and_quantity",
        "silhouette_and_proportions",
        "color_partitions",
        "materials_and_surfaces",
        "components",
        "relative_geometry",
        "logos_and_labels",
        "accessories_and_interfaces"
      ]
    },
    "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "must_not_change": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "view_specific_evidence": {"type": "object"},
    "evidence_conflicts": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["READY", "BLOCKED"]}
  }
}
