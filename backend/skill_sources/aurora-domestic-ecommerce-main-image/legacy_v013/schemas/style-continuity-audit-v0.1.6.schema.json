{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "style-continuity-audit-v0.1.6.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "status",
    "baseline_contract_mode",
    "pages",
    "set_gates",
    "error_counts",
    "profile01_semantics_read"
  ],
  "properties": {
    "schema_version": {"const": "style-continuity-audit-0.1.6"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "baseline_contract_mode": {
      "enum": ["PLANNED", "CALIBRATED_FROM_USER_APPROVED_PAGES"]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_index",
          "file",
          "status",
          "checks",
          "errors",
          "repair_scope"
        ],
        "properties": {
          "page_index": {"type": "integer", "minimum": 1, "maximum": 5},
          "file": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "BLOCKED"]},
          "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "errors": {"type": "array", "items": {"type": "string"}},
          "repair_scope": {
            "enum": [
              "NONE",
              "STYLE_LAYER_ONLY",
              "PRODUCT_OR_FACT_REPAIR_REQUIRED"
            ]
          }
        }
      }
    },
    "set_gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "error_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "profile01_semantics_read": {"const": false}
  }
}
