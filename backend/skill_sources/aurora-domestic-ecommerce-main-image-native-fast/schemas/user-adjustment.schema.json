{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-adjustment.schema.json",
  "type": "object",
  "required": ["scope", "page_index", "user_instruction_verbatim", "requested_visible_changes", "preserve", "changes_identity", "changes_verified_facts", "changes_campaign_style", "changes_page_role"],
  "properties": {
    "scope": {"const": "LOCAL_PAGE_DELTA"},
    "page_index": {"type": "integer", "minimum": 0, "maximum": 5},
    "user_instruction_verbatim": {"type": "string", "minLength": 2},
    "requested_visible_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "changes_identity": {"const": false},
    "changes_verified_facts": {"const": false},
    "changes_campaign_style": {"const": false},
    "changes_page_role": {"const": false}
  },
  "additionalProperties": false
}
