{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repair.schema.json",
  "type": "object",
  "required": ["scope", "failed_checks", "findings", "preserve", "strategy", "expected_visible_change"],
  "properties": {
    "scope": {"enum": ["STYLE_LAYER_ONLY", "LAYOUT_OR_COMPOSITION", "REBUILD_FROM_PRODUCT_EVIDENCE"]},
    "failed_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "preserve": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "strategy": {"type": "string", "minLength": 12},
    "expected_visible_change": {"type": "string", "minLength": 12}
  },
  "additionalProperties": false
}
